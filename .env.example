# Database Configuration
# Default: SQLite local for development. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./trivio_dev.db

# Cache Configuration
# Set REDIS_URL to enable Redis cache (e.g. redis://localhost:6379/0).
# Leave empty or unset to use fast in-memory TTL cache fallback.
REDIS_URL=
CACHE_DEFAULT_TTL_SECONDS=1800

# Identificação do Robô de Coleta (Conformidade)
# O Trivio se identifica honestamente no User-Agent e respeita o robots.txt.
# Preencha a URL/e-mail para que os sites coletados possam entrar em contato.
BOT_NAME=TrivioBot
BOT_VERSION=1.0
BOT_INFO_URL=
BOT_CONTACT_EMAIL=
RESPECT_ROBOTS_TXT=true
DEFAULT_CRAWL_DELAY_SECONDS=2.0

# Preços aéreos ao vivo (Ignav Flight Prices API: https://ignav.com)
# Sem a chave, o aéreo ao vivo fica desligado e o frontend é avisado.
IGNAV_API_KEY=
IGNAV_MARKET=BR
# Teto de requests pagas por mês (0 desliga). 1.000 requests grátis só uma vez; depois US$ 2 / 1.000.
AIR_MONTHLY_REQUEST_BUDGET=800
AIR_LIVE_CACHE_MAX_SECONDS=7200
# Gravar cotações ao vivo no histórico permanente (confira os termos do provedor antes)
AIR_PERSIST_LIVE_QUOTES=false
DEFAULT_DOMESTIC_BOARDING_FEE_BRL=40.0
# Endereço público da API (para links abertos pelo navegador)
PUBLIC_API_BASE_URL=http://localhost:8000

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
